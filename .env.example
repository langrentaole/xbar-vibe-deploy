# 镜像版本固定在明确版本；升级时只修改这里的版本号。
XBAR_VIBE_IMAGE=langrentaole/xbar-vibe:0.023

# Vibe 独立域名与证书通知邮箱。
VIBE_DOMAIN=vibe.example.com
ACME_EMAIL=admin@example.com

# Core 权益校验接口和同机 Sub2API 地址。
VIBE_CONTROL_URL=https://xbar.example.com/api/vibe-coding/gateway/internal
VIBE_UPSTREAM_URL=http://host.docker.internal:8080

# 必须与 xbar-core-deploy/.env 中的值完全一致。
VIBE_EDGE_SHARED_SECRET=copy-from-xbar-core

# 首次执行 ./deploy.sh init 时会自动生成，仅供 Caddy 与 Vibe Edge 互信。
VIBE_EDGE_ORIGIN_TOKEN=replace-with-random-origin-token
