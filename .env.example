# 镜像版本固定在明确版本；升级时只修改这里的版本号。
XBAR_VIBE_IMAGE=langrentaole/xbar-vibe:0.024.9

# Vibe 独立域名与证书通知邮箱。
VIBE_DOMAIN=vibe.example.com
ACME_EMAIL=admin@example.com

# Core 权益校验接口、Core 源站和同机 Sub2API 地址。
VIBE_CONTROL_URL=https://xbar.example.com/api/vibe-coding/gateway/internal
VIBE_CONTROL_HOST=xbar.example.com
VIBE_CONTROL_ORIGIN_IP=203.0.113.10
VIBE_UPSTREAM_URL=http://host.docker.internal:8080

# 从已授权 Core 的 GET /api/admin/license/status 复制站点 ID。
VIBE_STATION_ID=replace-with-core-station-id
# 当前 Vibe 服务器的出口公网 IP，必须与 Core 实际观察到的 IP 一致。
VIBE_PUBLIC_IP=203.0.113.20
VIBE_IDENTITY_DIR=/var/lib/xbar-vibe
XBAR_VIBE_VERSION=0.024.9

# 必须与 xbar-core-deploy/.env 中的值完全一致。
VIBE_EDGE_SHARED_SECRET=copy-from-xbar-core

# 首次执行 ./deploy.sh init 时会自动生成，仅供 Caddy 与 Vibe Edge 互信。
VIBE_EDGE_ORIGIN_TOKEN=replace-with-random-origin-token
